{
  "name": "trailbraid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
